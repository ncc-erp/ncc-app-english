# ==========================================
# CẤU HÌNH VPS & TRAEFIK
# ==========================================
APP_DOMAIN=english.mrdnd.dev
TRAEFIK_NETWORK=traefik-net
TRAEFIK_CERT_RESOLVER=letsencrypt
DOCKER_REGISTRY=registry.mrdnd.dev
IMAGE_TAG=latest

# Next.js Node Port
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# App URL công khai (dùng cho callback, metadata, robots...)
NEXT_PUBLIC_APP_URL=https://english.mrdnd.dev
NEXT_PUBLIC_MEZON_CLAN_INVITE_URL=https://mezon.ai/invite/your-clan-code
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page

# ==========================================
# CƠ SỞ DỮ LIỆU (PostgreSQL / Neon)
# ==========================================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==========================================
# LƯU TRỮ AUDIO (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ielts-recordings
# R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# ==========================================
# AI & SPEECH SERVICES
# ==========================================
AI_API_KEY=your_ai_api_key
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=your_deepgram_api_key

# ==========================================
# MEZON BOT & AUTH
# ==========================================
MEZON_BOT_TOKEN=your_mezon_bot_token
MEZON_BOT_ID=your_mezon_bot_id
SESSION_SECRET=create_a_random_32_character_secret_here_12345
BOT_HTTP_PORT=3100
BOT_VERIFY_SECRET=your_bot_verify_secret
MEZON_VERIFY_URL=http://localhost:3100
