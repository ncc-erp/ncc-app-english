# ==========================================
# CẤU HÌNH VPS & TRAEFIK
# ==========================================
APP_DOMAIN=english.mrdnd.dev
TRAEFIK_NETWORK=traefik-net
TRAEFIK_CERT_RESOLVER=letsencrypt
DOCKER_REGISTRY=registry.mrdnd.dev
IMAGE_TAG=latest

# Next.js Node Port
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# App URL công khai (dùng cho callback, metadata, robots...)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MEZON_CLAN_INVITE_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ==========================================
# CƠ SỞ DỮ LIỆU (PostgreSQL / Neon)
# ==========================================
# Recommended for most uses
DATABASE_URL=

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# ==========================================
# LƯU TRỮ AUDIO (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ielts-recordings
# R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# ==========================================
# AI & SPEECH SERVICES
# ==========================================
AI_API_KEY=
AI_ENDPOINT=
AI_MODEL=
DEEPGRAM_API_KEY=

# ==========================================
# MEZON BOT & AUTH
# ==========================================
# (Bot runs automatically within Next.js via instrumentation.ts)


# Session Management
SESSION_SECRET=

# Mezon Credentials
MEZON_APP_ID=
MEZON_APP_SECRET=
MEZON_CLIENT_ID=
MEZON_CLIENT_SECRET=
MEZON_REDIRECT_URI=

# Mezon Bot Credentials (for membership verification & notifications)
MEZON_BOT_ID=
MEZON_BOT_TOKEN=
MEZON_TARGET_CLAN_ID=
MEZON_CLAN_INVITE_URL=
MEZON_EXAM_CHANNEL_ID=
MEZON_WELCOME_CHANNEL_ID=
# Bật trang bảo trì cho toàn bộ app (true/false)
MAINTENANCE_MODE=false
